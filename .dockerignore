# Python bytecode & caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments (use the image's own packages, not local venv)
.venv/
venv/
env/
ENV/

# Git / IDE
.git/
.gitignore
.idea/
.vscode/
*.swp

# Secrets & local config (never bake into the image!)
.env

# Development / testing artifacts
test_logging.py
*.log
logs/

# Documentation (not needed at runtime)
README.md
CHANGELOG.md

# Docker files themselves (not needed inside image)
Dockerfile
docker-compose.yml
.dockerignore

