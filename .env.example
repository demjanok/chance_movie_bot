# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# TMDB API Key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Default movie filters
MIN_RATING=7.0
MIN_VOTES=150

# Default interface language (uk or en)
DEFAULT_LANGUAGE=uk

# Maximum pages to sample from (20 movies per page: 15 pages = 300 movies pool)
MAX_DISCOVERY_PAGES=15

# Number of recently seen movies to remember per user to prevent duplicates
SEEN_MOVIES_BUFFER_SIZE=50

# TTL in seconds for the in-memory TMDB discover-page cache (0 = disable cache)
# 600 = 10 min | 1200 = 20 min (default) | 3600 = 1 hour
DISCOVER_CACHE_TTL=1200

# Logging settings
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
# LOG_FORMAT: json (best practice for production/monitoring) or text (for local dev)
LOG_FORMAT=json
# Optional log file path (leave empty for stdout only; e.g. bot.log)
LOG_FILE=

